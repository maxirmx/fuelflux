# FuelFlux Environment Configuration
# Copy this file to /etc/fuelflux/fuelflux.env and modify as needed

# Controller ID: opaque unique string; blank/missing uses 232390330480219
# FUELFLUX_CONTROLLER_ID=232390330480220

# HTTP(S) backend base URL; blank/missing or invalid uses http://ttft.uxp.ru
# No credentials, query or fragment. Trailing slashes are removed.
# FUELFLUX_BACKEND_URL=http://ttft.uxp.ru

# Pump GPIO configuration
# FUELFLUX_PUMP_GPIO_CHIP=/dev/gpiochip0
# FUELFLUX_PUMP_RELAY_PIN=17
# FUELFLUX_PUMP_ACTIVE_LOW=true
